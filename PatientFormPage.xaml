<Page x:Class="YanaulKioskPerfect.PatientFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PatientForm" Background="#F5F9FC">
    <Grid Margin="48,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,36">
            <Button Style="{StaticResource ModernButton}" Background="#81C784"
                    Content="⇦ Назад" Width="160" Height="56" Click="BtnBack_Click"/>
            <TextBlock x:Name="TitleText" Text="ВВОД ДАННЫХ"
                       FontSize="38" FontWeight="Bold" Foreground="#00695C"
                       VerticalAlignment="Center" Margin="28,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Background="#E3F2FD">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40">
                    <TextBlock x:Name="DoctorInfo" Text="Врач: Иванова А.П. • Терапевт • Каб. 205"
                               FontSize="24" FontWeight="Bold" Foreground="#0D47A1"
                               Margin="0,0,0,48" TextAlignment="Center"/>

                    <TextBlock x:Name="NameLabel" Text="ФИО полностью:" 
                               FontSize="22" Margin="0,0,0,12"/>
                    <TextBox x:Name="NameBox" FontSize="20" Height="52" Padding="20,15"
                             VerticalContentAlignment="Center" BorderThickness="2" 
                             BorderBrush="#0288D1" Background="White"/>

                    <TextBlock x:Name="PolicyLabel" Text="Номер полиса ОМС:" 
                               FontSize="22" Margin="0,24,0,12"/>
                    <TextBox x:Name="PolicyBox" FontSize="20" Height="52" Padding="20,15"
                             VerticalContentAlignment="Center" BorderThickness="2" 
                             BorderBrush="#0288D1" Background="White"
                             TextChanged="PolicyBox_TextChanged"/>

                    <TextBlock x:Name="PhoneLabel" Text="Номер телефона:" 
                               FontSize="22" Margin="0,24,0,12"/>
                    <TextBox x:Name="PhoneBox" FontSize="20" Height="52" Padding="20,15"
                             VerticalContentAlignment="Center" BorderThickness="2" 
                             BorderBrush="#0288D1" Background="White"
                             TextChanged="PhoneBox_TextChanged"/>

                    <Button x:Name="SubmitBtn" Style="{StaticResource ModernButton}" 
                            Background="#0288D1" Content="ПОЛУЧИТЬ ТАЛОН" 
                            FontSize="22" Height="68" Margin="0,48,0,0"
                            Click="BtnSubmit_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>