<Page x:Class="YanaulKioskPerfect.HomeVisitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вызов врача на дом" Background="#F5F9FC">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="900">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Style="{StaticResource ModernButton}" Background="#81C784" Content="⇦ Назад"
                        Width="160" Height="56" Click="BtnBack_Click"/>
                <TextBlock Text="🚑 ВЫЗОВ ВРАЧА НА ДОМ" FontSize="36" FontWeight="Bold" Foreground="#C62828"
                           VerticalAlignment="Center" Margin="24,0,0,0"/>
            </StackPanel>

            <Border x:Name="PatientInfoBar" Style="{StaticResource CardStyle}" Background="#E3F2FD" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Пациент в системе" FontSize="13" Foreground="#1565C0"/>
                        <TextBlock x:Name="LblPatientName" FontSize="22" FontWeight="Bold" Foreground="#0D47A1"/>
                        <TextBlock x:Name="LblPatientPolicy" FontSize="14" Foreground="#555" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="✓" FontSize="40" Foreground="#2E7D32" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Background="White" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="📋 Как это работает" FontSize="20" FontWeight="Bold" Foreground="#00695C" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" FontSize="15" Foreground="#555" LineHeight="22">
                        1. Заполните адрес и симптомы — заявка попадёт в диспетчерскую ЦРБ.
                        2. Диспетчер перезвонит для подтверждения выезда.
                        3. Статус заявки можно увидеть в уведомлениях медкарты.
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Background="White">
                <StackPanel>
                    <TextBlock Text="📍 Адрес выезда" FontWeight="Bold" FontSize="17" Foreground="#37474F" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtAddress" Height="52" FontSize="16" Padding="14,10" Margin="0,0,0,18"/>

                    <TextBlock Text="📞 Контактный телефон" FontWeight="Bold" FontSize="17" Foreground="#37474F" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtPhone" Height="52" FontSize="16" Padding="14,10" Margin="0,0,0,18"/>

                    <TextBlock Text="🩺 Симптомы и жалобы" FontWeight="Bold" FontSize="17" Foreground="#37474F" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtSymptoms" Height="110" TextWrapping="Wrap" FontSize="16" Padding="14,10"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"/>

                    <TextBlock Text="⚡ Срочность выезда" FontWeight="Bold" FontSize="17" Margin="0,0,0,10"/>
                    <StackPanel Margin="0,0,0,16">
                        <RadioButton x:Name="RbNormal" Content="Плановая — в течение рабочего дня" FontSize="15" Margin="0,0,0,8" IsChecked="True"/>
                        <RadioButton x:Name="RbUrgent" Content="Срочная — 2–4 часа" FontSize="15" Margin="0,0,0,8"/>
                        <RadioButton x:Name="RbEmergency" Content="🆘 Экстренная — до 1 часа" FontSize="15" FontWeight="Bold" Foreground="#C62828"/>
                    </StackPanel>

                    <TextBlock Text="Дополнительно" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                    <CheckBox x:Name="CheckFever" Content="🌡️ Температура выше 38°C" FontSize="15" Margin="0,0,0,8"/>
                    <CheckBox x:Name="CheckChild" Content="👶 Ребёнок до 14 лет" FontSize="15" Margin="0,0,0,8"/>
                    <CheckBox x:Name="CheckElderly" Content="👴 Пожилой пациент" FontSize="15" Margin="0,0,0,16"/>

                    <Border Background="#FFF8E1" CornerRadius="12" Padding="14" Margin="0,0,0,20">
                        <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#5D4037">
                            При боли в груди, потере сознания или кровотечении — звоните 103. Форма для вызова врача на дом в рамках ЦРБ.
                        </TextBlock>
                    </Border>

                    <Button Style="{StaticResource ModernButton}" Background="#D32F2F" Foreground="White"
                            Content="📤 ОТПРАВИТЬ ЗАЯВКУ В ДИСПЕТЧЕРСКУЮ" FontSize="18" Height="64"
                            Click="BtnCallDoctor_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
