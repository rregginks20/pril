<Page x:Class="YanaulKioskPerfect.TimeSelectionPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Выбор времени приема" Background="#F5F9FC">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- === ЗАГОЛОВОК === -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30">
                <Button x:Name="BtnBack" Style="{StaticResource ModernButton}" Background="#81C784"
Content="⇦ Назад" Width="160" Height="56" Click="BtnBack_Click"/>
                <StackPanel Margin="28,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="ВЫБОР ВРЕМЕНИ ПРИЕМА"
FontSize="36" FontWeight="Bold" Foreground="#00695C"/>
                    <TextBlock x:Name="SubtitleText" Text="Шаг 4 из 5: Выберите удобное время"
FontSize="18" Foreground="#004D40" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- === ИНФОРМАЦИЯ О ВРАЧЕ === -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Background="White" Margin="0,0,0,20">
                <Grid Margin="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="130" Height="130" CornerRadius="65" 
Background="#E0F2F1" BorderBrush="#009688" BorderThickness="3" ClipToBounds="True">
                        <Image x:Name="DoctorPhoto" Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="25,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DoctorNameText" Text="Иванова Анна Петровна" 
FontSize="26" FontWeight="Bold" Foreground="#00695C"/>
                        <TextBlock x:Name="DoctorSpecialtyText" Text="Терапевт" 
FontSize="18" Foreground="Gray" Margin="0,5,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="🚪 Кабинет: " FontSize="15" Foreground="Gray"/>
                            <TextBlock x:Name="DoctorRoomText" Text="205" FontSize="15" FontWeight="SemiBold" Foreground="#00897B"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="📋 Категория: " FontSize="15" Foreground="Gray"/>
                            <TextBlock x:Name="DoctorCategoryText" Text="Высшая" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="⏱️ Стаж: " FontSize="15" Foreground="Gray"/>
                            <TextBlock x:Name="DoctorExperienceText" Text="18 лет" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="⭐ Рейтинг: " FontSize="15" Foreground="Gray"/>
                            <TextBlock x:Name="DoctorRatingText" Text="4.8" FontSize="15" FontWeight="SemiBold" Foreground="Orange"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- === ВЫБОР ТИПА УСЛУГИ (УЛУЧШЕННЫЙ) === -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Background="White" Margin="0,0,0,20">
                <StackPanel Margin="25">
                    <TextBlock Text="📌 ТИП УСЛУГИ" FontSize="20" FontWeight="Bold" Foreground="#00695C" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- БЕСПЛАТНО (ОМС) -->
                        <Border Grid.Column="0" Background="#E8F5E9" CornerRadius="15" Padding="20" BorderBrush="#4CAF50" BorderThickness="3">
                            <StackPanel>
                                <RadioButton x:Name="RadioFree" Content="💚 Бесплатно (по ОМС)" FontSize="18" FontWeight="Bold"
IsChecked="True" Margin="0,0,0,15" Checked="RadioFree_Checked"
Foreground="#2E7D32"/>

                                <TextBlock Text="✅ Что входит:" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="• Первичный осмотр врача" FontSize="14" Foreground="#555" Margin="0,3,0,0"/>
                                <TextBlock Text="• Консультация специалиста" FontSize="14" Foreground="#555" Margin="0,3,0,0"/>
                                <TextBlock Text="• Электронная медкарта" FontSize="14" Foreground="#555" Margin="0,3,0,0"/>
                                <TextBlock Text="• Больничный лист" FontSize="14" Foreground="#555" Margin="0,3,0,0"/>

                                <Border Background="#4CAF50" CornerRadius="8" Padding="10,5" Margin="0,15,0,0">
                                    <TextBlock Text="💰 0 ₽ (полностью бесплатно)" FontSize="15" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#E0E0E0" Width="2" Margin="0,10"/>

                        <!-- ПЛАТНО -->
                        <Border Grid.Column="2" Background="#FFF3E0" CornerRadius="15" Padding="20" BorderBrush="#FF9800" BorderThickness="3">
                            <StackPanel>
                                <RadioButton x:Name="RadioPaid" Content="💳 Платная услуга" FontSize="18" FontWeight="Bold"
Margin="0,0,0,15" Checked="RadioPaid_Checked"
Foreground="#E65100"/>

                                <TextBlock Text="✅ Что входит:" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="• Всё из ОМС +" FontSize="14" Foreground="#555" Margin="0,3,0,0"/>
                                <TextBlock Text="• Расширенные анализы" FontSize="14" Foreground="#555" Margin="0,3,0,0"/>
                                <TextBlock Text="• Справка в день обращения" FontSize="14" Foreground="#555" Margin="0,3,0,0"/>
                                <TextBlock Text="• Приоритетная запись" FontSize="14" Foreground="#555" Margin="0,3,0,0"/>

                                <Border Background="#FF9800" CornerRadius="8" Padding="10,5" Margin="0,15,0,0">
                                    <TextBlock Text="💰 от 300 ₽" FontSize="15" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="PaidServicesPanel" Visibility="Collapsed" Background="#FFF3E0" 
CornerRadius="10" Padding="20" Margin="0,20,0,0" BorderBrush="#FFB74D" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="📋 Выберите платную услугу:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            <ComboBox x:Name="PaidServicesCombo" FontSize="15" Width="500" HorizontalAlignment="Left"
SelectionChanged="PaidServicesCombo_SelectionChanged" Padding="10,5"/>
                            <TextBlock x:Name="ServicePriceText" Text="Стоимость: 0 ₽" FontSize="18" 
Foreground="#E65100" FontWeight="Bold" Margin="0,15,0,0"/>
                            <TextBlock x:Name="ServiceDescriptionText" Text="" FontSize="14" 
Foreground="#555" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- === КАЛЕНДАРЬ === -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Background="White" Margin="0,0,0,20">
                <StackPanel Margin="25">
                    <TextBlock Text="📅 ВЫБЕРИТЕ ДАТУ ПРИЕМА" FontSize="20" FontWeight="Bold" 
Foreground="#00695C" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnPrevDay" Content="◀" Width="50" Height="40" FontSize="18" 
Background="#E0F2F1" Click="BtnPrevDay_Click"/>
                        <Border Background="#00897B" CornerRadius="8" Padding="30,10" Margin="15,0">
                            <TextBlock x:Name="SelectedDateText" Text="29 Апреля 2026" FontSize="18" 
Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                        <Button x:Name="BtnNextDay" Content="▶" Width="50" Height="40" FontSize="18" 
Background="#E0F2F1" Click="BtnNextDay_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- === ВРЕМЕННЫЕ СЛОТЫ === -->
            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Background="White" Margin="0,0,0,20">
                <StackPanel Margin="25">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="🕐 ДОСТУПНОЕ ВРЕМЯ" FontSize="20" FontWeight="Bold" Foreground="#00695C"/>
                        <TextBlock x:Name="SlotsCountText" Text=" (24 слотов)" FontSize="18" Foreground="Gray" Margin="10,0,0,0"/>
                    </StackPanel>
                    <WrapPanel x:Name="TimeSlotsPanel" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="NoSlotsMessage" Text="На эту дату нет свободных мест. Выберите другую дату." 
FontSize="16" Foreground="Red" TextAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- === ИНФОРМАЦИЯ О ЗАПИСИ === -->
            <Border Grid.Row="5" Style="{StaticResource CardStyle}" Background="#E8F5E9" Margin="0,0,0,20">
                <StackPanel Margin="25">
                    <TextBlock Text="📋 ИНФОРМАЦИЯ О ЗАПИСИ" FontSize="20" FontWeight="Bold" 
Foreground="#00695C" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="👤 Пациент:" FontSize="15" Foreground="Gray"/>
                            <TextBlock x:Name="PatientNameText" Text="Иванов Иван Иванович" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="📄 Полис ОМС:" FontSize="15" Foreground="Gray" Margin="0,10,0,0"/>
                            <TextBlock x:Name="PolicyNumberText" Text="1234567890123456" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="📱 Телефон:" FontSize="15" Foreground="Gray" Margin="0,10,0,0"/>
                            <TextBlock x:Name="PatientPhoneText" Text="+7 (___) ___-__-__" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="15,0,0,0">
                            <TextBlock Text="🏥 Врач:" FontSize="15" Foreground="Gray"/>
                            <TextBlock x:Name="SummaryDoctorText" Text="Иванова А.П." FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="📅 Дата и время:" FontSize="15" Foreground="Gray" Margin="0,10,0,0"/>
                            <TextBlock x:Name="SummaryDateTimeText" Text="—" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="💰 Стоимость:" FontSize="15" Foreground="Gray" Margin="0,10,0,0"/>
                            <TextBlock x:Name="SummaryPriceText" Text="Бесплатно" FontSize="16" FontWeight="SemiBold" Foreground="Green"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- === КНОПКИ ДЕЙСТВИЙ === -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,40">
                <Button x:Name="BtnConfirm" Content="✅ ПОДТВЕРДИТЬ ЗАПИСЬ" Width="320" Height="70" 
FontSize="20" FontWeight="Bold" Background="#4CAF50" Foreground="White" 
BorderThickness="0" Click="BtnConfirm_Click" Cursor="Hand"
Margin="0,0,30,0"/>
                <Button x:Name="BtnCancel" Content="❌ ОТМЕНА" Width="200" Height="70" FontSize="20" 
Background="#F44336" Foreground="White" BorderThickness="0" 
Click="BtnCancel_Click" Cursor="Hand"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>