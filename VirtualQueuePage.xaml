<Page x:Class="YanaulKioskPerfect.VirtualQueuePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="VirtualQueue" Background="#F5F9FC">
    <Grid Margin="48,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,36">
            <Button Style="{StaticResource ModernButton}" Background="#81C784"
                    Content="⇦ Назад" Width="160" Height="56" Click="BtnBack_Click"/>
            <TextBlock x:Name="TitleText" Text="ВИРТУАЛЬНАЯ ОЧЕРЕДЬ"
                       FontSize="38" FontWeight="Bold" Foreground="#00695C"
                       VerticalAlignment="Center" Margin="28,0,0,0"/>
            <Button x:Name="RefreshBtn" Style="{StaticResource ModernButton}" 
                    Background="#0288D1" Content="🔄 Обновить" Width="180" Height="56"
                    Margin="28,0,0,0" Click="RefreshBtn_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Список очереди -->
            <Border Style="{StaticResource CardStyle}" Grid.Column="0" Background="#E3F2FD">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="QueueHeaderText" Text="ЖИВАЯ ОЧЕРЕДЬ" 
                               FontSize="22" FontWeight="Bold" Foreground="#0D47A1"
                               Margin="0,0,0,24" TextWrapping="Wrap"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="QueuePanel">
                            <!-- Динамически заполняется -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Информация о текущем пациенте -->
            <Border Style="{StaticResource CardStyle}" Grid.Column="1" Background="#FFF3E0" Margin="32,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📊" FontSize="64" Margin="0,0,0,16"/>
                    <TextBlock Text="ВАША ПОЗИЦИЯ" FontSize="22" FontWeight="Bold" 
                               Foreground="#E65100" Margin="0,0,0,8"/>
                    <TextBlock x:Name="PositionText" Text="№ 3" FontSize="72" FontWeight="Bold" 
                               Foreground="#D84315" Margin="0,0,0,24"/>
                    <TextBlock Text="ПРИМЕРНОЕ ВРЕМЯ" FontSize="22" FontWeight="Bold" 
                               Foreground="#E65100" Margin="0,0,0,8"/>
                    <TextBlock x:Name="WaitTimeText" Text="15 минут" FontSize="40" FontWeight="Bold" 
                               Foreground="#BF360C" Margin="0,0,0,12"/>
                    <TextBlock x:Name="MyStatusText" Text="" FontSize="16" Foreground="#5D4037"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24"/>
                    <Button Style="{StaticResource ModernButton}" Background="#FF5722"
                            Content="🔔 УВЕДОМИТЬ" FontSize="20" Height="64" Margin="0,0,0,14"
                            Click="NotifyBtn_Click"/>
                    <Button Style="{StaticResource ModernButton}" Background="#5C6BC0"
                            Content="🎫 Мои записи" FontSize="18" Height="58"
                            Click="BtnMyTickets_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>