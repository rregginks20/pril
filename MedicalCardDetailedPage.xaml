<Page x:Class="YanaulKioskPerfect.MedicalCardDetailedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Медицинская карта" Background="#F5F9FC">

    <Grid Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30">
            <Button Style="{StaticResource ModernButton}" Background="#81C784" Content="⇦ Назад" Width="160" Height="60" FontSize="20" Click="BtnBack_Click"/>
            <TextBlock x:Name="TitleText" Text="МЕДИЦИНСКАЯ КАРТА ПАЦИЕНТА" FontSize="42" FontWeight="Bold" Foreground="#004D40" VerticalAlignment="Center" Margin="30,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: Профиль пациента -->
            <Border Style="{StaticResource CardStyle}" Background="White" Grid.Column="0" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="25">
                        <TextBlock Text="👤 ПАЦИЕНТ" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#00695C"/>

                        <!-- Аватарка (заглушка) -->
                        <Border Background="#E0F2F1" CornerRadius="75" Width="150" Height="150" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock Text="👤" FontSize="80" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#00695C"/>
                        </Border>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="ФИО:" FontSize="14" Foreground="#757575"/>
                            <TextBlock x:Name="PatientNameText" Text="Загрузка..." FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Полис ОМС:" FontSize="14" Foreground="#757575"/>
                            <TextBlock x:Name="PolicyText" Text="-" FontSize="18" FontWeight="SemiBold" Foreground="#0288D1"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Дата рождения:" FontSize="14" Foreground="#757575"/>
                                <TextBlock x:Name="DobText" Text="-" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Пол:" FontSize="14" Foreground="#757575"/>
                                <TextBlock x:Name="GenderText" Text="-" FontSize="16"/>
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="2" Fill="#E0E0E0" Margin="0,15,0,15"/>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Группа крови:" FontSize="14" Foreground="#757575"/>
                            <TextBlock x:Name="BloodTypeText" Text="-" FontSize="18" FontWeight="Bold" Foreground="#D32F2F"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Аллергии:" FontSize="14" Foreground="#757575"/>
                            <TextBlock x:Name="AllergiesText" Text="Нет данных" FontSize="15" TextWrapping="Wrap" Foreground="#BF360C"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Хронические заболевания:" FontSize="14" Foreground="#757575"/>
                            <TextBlock x:Name="ChronicText" Text="Нет данных" FontSize="15" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Правая панель: Вкладки -->
            <TabControl Grid.Column="1" Margin="20,0,0,0" FontSize="18" Background="Transparent">
                <TabItem Header="📋 История посещений">
                    <Border Style="{StaticResource CardStyle}" Background="White" Margin="10">
                        <DataGrid x:Name="VisitsGrid" AutoGenerateColumns="False" HeadersVisibility="Column" 
                                  RowHeight="60" FontSize="16" BorderThickness="0" Background="White" IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                    <Setter Property="Foreground" Value="#1B5E20"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="15,10"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата и время" Binding="{Binding Date}" Width="150"/>
                                <DataGridTextColumn Header="Врач" Binding="{Binding Doctor}" Width="200"/>
                                <DataGridTextColumn Header="Диагноз / Жалобы" Binding="{Binding Diagnosis}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>

                <TabItem Header="💉 Прививки">
                    <Border Style="{StaticResource CardStyle}" Background="White" Margin="10">
                        <DataGrid x:Name="VaccinesGrid" AutoGenerateColumns="False" HeadersVisibility="Column" 
                                  RowHeight="60" FontSize="16" BorderThickness="0" Background="White" IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FFF3E0"/>
                                    <Setter Property="Foreground" Value="#E65100"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="15,10"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="120"/>
                                <DataGridTextColumn Header="Вакцина" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Серия №" Binding="{Binding Series}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>

                <TabItem Header="🧪 Анализы">
                    <Border Style="{StaticResource CardStyle}" Background="White" Margin="10">
                        <DataGrid x:Name="AnalysesGrid" AutoGenerateColumns="False" HeadersVisibility="Column" 
                                  RowHeight="60" FontSize="16" BorderThickness="0" Background="White" IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                    <Setter Property="Foreground" Value="#0D47A1"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="15,10"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="120"/>
                                <DataGridTextColumn Header="Название анализа" Binding="{Binding Name}" Width="200"/>
                                <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="*"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>