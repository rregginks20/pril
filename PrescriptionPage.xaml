<Page x:Class="YanaulKioskPerfect.PrescriptionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои рецепты" Background="#F5F9FC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="← Назад" Width="120" Height="40" Click="BtnBack_Click" 
                    Background="#FF9800" Foreground="White" FontWeight="Bold"/>
            <TextBlock Text="💊 Мои рецепты" FontSize="28" FontWeight="Bold" 
                       Foreground="#E65100" Margin="20,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <ListBox x:Name="PrescriptionsList" Grid.Row="1" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,10" 
                            BorderBrush="#FFE0B2" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding IssueDate, StringFormat={}{0:dd.MM.yyyy}}" 
                                           FontWeight="Bold" FontSize="16" Foreground="#E65100"/>
                                <TextBlock Text="{Binding Medicines}" TextWrapping="Wrap" Margin="0,5,0,5"/>
                                <TextBlock Text="{Binding DosageInstructions}" FontStyle="Italic" Foreground="#555"/>
                                <TextBlock Text="{Binding ValidUntil, StringFormat='Действительно до: {0:dd.MM.yyyy}'}" 
                                           Foreground="#777" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <Button Content="🖨️ Печать" Click="PrintRecipe_Click" Tag="{Binding}"
                                        Background="#FF9800" Foreground="White" Padding="10,5" Margin="0,0,0,5"/>
                                <Button Content="💾 Сохранить" Click="SaveRecipe_Click" Tag="{Binding}"
                                        Background="#4CAF50" Foreground="White" Padding="10,5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>