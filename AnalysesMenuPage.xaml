<Page x:Class="YanaulKioskPerfect.AnalysesMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Анализы" Background="#F5F9FC">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30">
                <Button Style="{StaticResource ModernButton}" Background="#81C784" Content="⇦ Назад" Width="160" Height="60" FontSize="20" Click="BtnBack_Click"/>
                <TextBlock x:Name="TitleText" Text="ЛАБОРАТОРИЯ И АНАЛИЗЫ" FontSize="42" FontWeight="Bold" Foreground="#004D40" VerticalAlignment="Center" Margin="30,0,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- Список анализов -->
                <Border Style="{StaticResource CardStyle}" Background="White" Grid.Column="0">
                    <DockPanel>
                        <TextBlock Text="Доступные виды анализов" FontSize="26" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,20"/>
                        <ListBox x:Name="AnalysesList" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F5F5F5" Padding="20" Margin="0,0,0,10" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding NameRU}" FontSize="20" FontWeight="Bold" Foreground="#00695C"/>
                                                <TextBlock Text="{Binding Preparation}" FontSize="14" Foreground="#757575" FontStyle="Italic" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0} ₽}" FontSize="22" FontWeight="Bold" Foreground="#D84315" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <Button Grid.Column="2" Content="Записаться" Height="45" FontSize="16" Background="#00897B" Foreground="White" BorderThickness="0" Cursor="Hand" Tag="{Binding AnalysisId}" Click="BtnBookAnalysis_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Правая панель: Мои результаты -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Background="#E3F2FD" Margin="20,0,0,0">
                    <StackPanel>
                        <TextBlock Text="📋 Мои результаты" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#0D47A1"/>

                        <Button Style="{StaticResource ModernButton}" Background="#1976D2" Content="🔍 Проверить результаты" Height="70" FontSize="18" Margin="0,0,0,15" Click="BtnMyResults_Click"/>

                        <TextBlock Text="Или введите номер полиса:" FontSize="16" Margin="0,0,0,10" Foreground="#555"/>
                        <TextBox x:Name="PolicySearchBox" FontSize="18" Height="45" Padding="10" Margin="0,0,0,15"/>
                        <Button Content="Найти" Height="45" Background="#0288D1" Foreground="White" FontSize="16" Click="BtnSearchResults_Click"/>

                        <TextBlock x:Name="ResultInfo" Text="" FontSize="14" Margin="0,20,0,0" TextWrapping="Wrap" Foreground="#333"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>