<Page x:Class="YanaulKioskPerfect.PaymentHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="История платежей" Background="#F5F9FC">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="← Назад" Width="140" Height="48" Click="BtnBack_Click"
                    Background="#009688" Foreground="White" FontWeight="Bold" FontSize="16"/>
            <TextBlock x:Name="TitleText" Text="💳 История платежей" FontSize="28" FontWeight="Bold"
                       Foreground="#00695C" Margin="20,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15"
                BorderBrush="#B2DFDB" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="SummaryText" Text="Всего операций: 0" FontSize="18" FontWeight="SemiBold" Foreground="#333"/>
                <TextBlock x:Name="TotalSumText" Text="Сумма: 0 ₽" FontSize="16" Foreground="#E65100" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PaymentsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12"
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding ServiceRU}" FontSize="18" FontWeight="Bold" Foreground="#00695C"/>
                                    <TextBlock Text="{Binding PaymentDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                               FontSize="14" Foreground="#666" Margin="0,4,0,0"/>
                                    <TextBlock FontSize="13" Foreground="#888" Margin="0,4,0,0">
                                        <Run Text="Способ: "/>
                                        <Run Text="{Binding PaymentMethod}"/>
                                        <Run Text="  |  Чек: "/>
                                        <Run Text="{Binding ReceiptNumber}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Status}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:N0} ₽'}"
                                           FontSize="22" FontWeight="Bold" Foreground="#E65100"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText" Grid.Row="2" Text="Платежей пока нет"
                   FontSize="18" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Page>
