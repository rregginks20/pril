<Page x:Class="YanaulKioskPerfect.NewPatientCardPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Создание медицинской карты" Background="#F5F9FC">

    <Grid Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,40">
            <TextBlock Text="📋 СОЗДАНИЕ МЕДИЦИНСКОЙ КАРТЫ" FontSize="32" FontWeight="Bold" 
Foreground="#00695C" HorizontalAlignment="Center"/>
            <TextBlock Text="Заполните данные пациента" FontSize="18" 
Foreground="Gray" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Background="White" 
MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="40,40">

                <TextBlock Text="📄 Полис ОМС:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock x:Name="PolicyText" FontSize="16" Foreground="#00897B" 
Margin="0,0,0,20" FontWeight="Bold"/>

                <TextBlock Text="👤 ФИО пациента:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="FullNameTextBox" FontSize="16" Height="45" 
Margin="0,0,0,20"/>

                <TextBlock Text="📱 Телефон:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="PhoneTextBox" FontSize="16" Height="45" 
Margin="0,0,0,20"/>

                <TextBlock Text="📅 Дата рождения:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <DatePicker x:Name="BirthDatePicker" FontSize="16" Height="45" 
Margin="0,0,0,30"/>

                <Button x:Name="BtnCreateCard" Content="✅ СОЗДАТЬ КАРТУ И ЗАПИСАТЬСЯ" 
Background="#4CAF50" Foreground="White" Height="60" FontSize="18" 
FontWeight="Bold" Click="BtnCreateCard_Click" Margin="0,0,0,15"
Cursor="Hand"/>

                <Button Content="❌ ОТМЕНА" Background="#F44336" Foreground="White" 
Height="50" FontSize="16" Click="BtnCancel_Click" Cursor="Hand"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>