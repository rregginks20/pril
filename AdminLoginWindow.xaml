<Window x:Class="YanaulKioskPerfect.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход для персонала" 
        Height="500" Width="450"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="#F0F4F8">

    <!-- Основная рамка с явной тенью вместо CardShadow -->
    <Border Background="White" CornerRadius="25" Padding="50" Margin="30">
        <Border.Effect>
            <DropShadowEffect Color="#444444" BlurRadius="25" ShadowDepth="8" Opacity="0.2"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">

            <!-- Заголовок -->
            <TextBlock Text="🔐 Вход для персонала" 
                       FontSize="32" FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,40" 
                       Foreground="#00695C"/>

            <!-- Поле Логин -->
            <TextBlock Text="Логин:" FontSize="20" Margin="0,0,0,10" FontWeight="SemiBold"/>
            <TextBox x:Name="LoginBox" 
                     FontSize="22" Height="auto" Padding="15" 
                     Margin="0,0,0,25"
                     BorderBrush="#B0BEC5" BorderThickness="2"/>

            <!-- Поле Пароль -->
            <TextBlock Text="Пароль:" FontSize="20" Margin="0,0,0,10" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PasswordBox" 
                         FontSize="22" Height="55" Padding="15" 
                         Margin="0,0,0,40"
                         BorderBrush="#B0BEC5" BorderThickness="2"/>

            <!-- Кнопка ВОЙТИ -->
            <Button Content="ВОЙТИ В СИСТЕМУ" 
                    FontSize="24" FontWeight="Bold" 
                    Height="70"
                    Background="#00897B" Foreground="White" 
                    BorderThickness="0"
                    Click="BtnLogin_Click" Cursor="Hand"
                    Margin="0,0,0,15">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00796B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Кнопка ОТМЕНА -->
            <Button Content="ОТМЕНА" 
                    FontSize="18" Height="50" 
                    Background="Transparent" Foreground="#757575" 
                    BorderThickness="0"
                    Click="BtnCancel_Click" Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>