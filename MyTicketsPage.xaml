<Page x:Class="YanaulKioskPerfect.MyTicketsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MyTickets" Background="#F5F9FC">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="48,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,36">
                <Button Style="{StaticResource ModernButton}" Background="#81C784"
                        Content="⇦ Назад" Width="160" Height="56" Click="BtnBack_Click"/>
                <TextBlock x:Name="TitleText" Text="МОИ ЗАПИСИ"
                           FontSize="38" FontWeight="Bold" Foreground="#00695C"
                           VerticalAlignment="Center" Margin="28,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" x:Name="TicketsPanel">
                <!-- Динамически заполняется в коде -->
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>