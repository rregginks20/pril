<Page x:Class="YanaulKioskPerfect.TriagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Умный подбор врача" Background="#F5F9FC">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30">
        <StackPanel MaxWidth="700" HorizontalAlignment="Center">
            <TextBlock Text="🤖 УМНЫЙ ПОДБОР ВРАЧА" FontSize="32" FontWeight="Bold" Foreground="#8E44AD" Margin="0,0,0,10" TextAlignment="Center"/>
            <TextBlock Text="Опишите симптомы, и система подскажет специалиста." FontSize="16" Foreground="#555" Margin="0,0,0,30" TextAlignment="Center"/>
            <Border Background="White" CornerRadius="15" Padding="30" BorderBrush="#E1BEE7" BorderThickness="1">
                <StackPanel>
                    <TextBox x:Name="TxtSymptoms" Height="100" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,20" Padding="10" Text="Болит голова и температура"/>
                    <Button Content="🔍 ПОДОБРАТЬ ВРАЧА" Height="55" FontSize="18" FontWeight="Bold" Background="#8E44AD" Foreground="White" BorderThickness="0" Click="BtnAnalyze_Click" Cursor="Hand" Margin="0,0,0,20"/>
                    <Border x:Name="ResultBox" Background="#F3E5F5" CornerRadius="10" Padding="20" Visibility="Collapsed" BorderBrush="#BA68C8" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="LblRecommendation" FontSize="20" FontWeight="Bold" Foreground="#4A148C" TextWrapping="Wrap"/>
                            <TextBlock x:Name="LblDoctorName" FontSize="16" Foreground="#6A1B9A" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <Button Content="📅 Записаться к этому врачу" Height="45" Margin="0,20,0,0" Background="#AB47BC" Foreground="White" BorderThickness="0" Click="BtnBook_Click" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                    <Button Content="← Назад" Height="45" Margin="0,20,0,0" Background="Transparent" Foreground="#7F8C8D" Click="BtnBack_Click" Cursor="Hand" BorderThickness="0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>