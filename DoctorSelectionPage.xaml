<Page x:Class="YanaulKioskPerfect.DoctorSelectionPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Выбор врача" Background="#F5F9FC">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="48,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,36">
                <Button x:Name="BtnBack" Style="{StaticResource ModernButton}" Background="#81C784"
Content="⇦ Назад" Width="160" Height="56" Click="BtnBack_Click"/>
                <StackPanel Margin="28,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="ВЫБОР ВРАЧА"
FontSize="38" FontWeight="Bold" Foreground="#00695C"/>
                    <TextBlock x:Name="SubtitleText" Text="Специальность: ..."
FontSize="22" Foreground="#004D40" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Панель врачей -->
            <WrapPanel x:Name="DoctorsPanel" Grid.Row="1" HorizontalAlignment="Center"/>
        </Grid>
    </ScrollViewer>
</Page>