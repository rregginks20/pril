<Page x:Class="YanaulKioskPerfect.EmergencyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Emergency" Background="#FFEBEE">
    <Grid Margin="48,36">
        <Border Background="#FFCDD2" CornerRadius="24" Padding="48">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🚨" FontSize="80" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Text="ЭКСТРЕННЫЙ ВЫЗОВ"
                           FontSize="42" FontWeight="Bold" Foreground="#B71C1C"
                           Margin="0,24,0,32" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DescText" Text="Нажмите кнопку ниже, чтобы вызвать скорую помощь"
                           FontSize="22" Foreground="#D32F2F" TextAlignment="Center" Margin="0,0,0,40"/>
                <Button x:Name="SOSBtn" Style="{StaticResource ModernButton}" Background="#D32F2F"
                        Content="❗ ВЫЗВАТЬ СКОРУЮ ❗" FontSize="26" Height="90" Width="500"
                        Click="SOSBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>