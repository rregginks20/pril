<Window x:Class="YanaulKioskPerfect.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Терминал Янаульской ЦРБ"
Height="768" Width="1366"
WindowStartupLocation="CenterScreen"
WindowStyle="None"
ResizeMode="NoResize"
Background="#ECEFF1"
MouseMove="Window_MouseMove"
KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="96"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00695C" Offset="0"/>
                    <GradientStop Color="#00897B" Offset="0.55"/>
                    <GradientStop Color="#26A69A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Direction="270"/>
            </Border.Effect>
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFFFFF22" CornerRadius="12" Padding="10,6" Margin="0,0,14,0">
                        <TextBlock Text="🏥" FontSize="36"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ЯНАУЛЬСКАЯ ЦЕНТРАЛЬНАЯ РАЙОННАЯ БОЛЬНИЦА"
                                   FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="ул. Худайбердина, 65А, г. Янаул"
                                   FontSize="14" Foreground="#B2DFDB" Margin="0,3,0,0"/>
                        <TextBlock x:Name="PatientBadge" Text="" FontSize="13" Foreground="#E0F2F1"
                                   FontWeight="SemiBold" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="#FFFFFF18" CornerRadius="10" Padding="12,8" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock x:Name="ClockDate" Text="01.01.2026" FontSize="14" Foreground="#E0F2F1" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ClockTime" Text="12:00:00" FontSize="26" FontWeight="Bold" Foreground="White"
                                       FontFamily="Consolas" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnLangRU" Content="РУС" FontSize="16" Width="88" Height="46"
                            Background="#00897B" Foreground="White" BorderThickness="0"
                            Click="BtnLangRU_Click" Cursor="Hand" Margin="0,0,8,0"/>
                    <Button x:Name="BtnLangBA" Content="БАШ" FontSize="16" Width="88" Height="46"
                            Background="#00897B" Foreground="White" BorderThickness="0"
                            Click="BtnLangBA_Click" Cursor="Hand" Margin="0,0,8,0"/>
                    <Button x:Name="BtnExit" Content="🚪 ВЫХОД" FontSize="16" Width="150" Height="46"
                            Background="#C62828" Foreground="White" BorderThickness="0"
                            Click="BtnExit_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Background="#ECEFF1">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"
                   Background="Transparent" Margin="20,10"/>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#004D40">
            <Grid Margin="20,0">
                <TextBlock x:Name="FooterText"
                           Text="Терминал самообслуживания | Регистратура: +7 (34783) 2-14-79"
                           FontSize="15" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Text="Коснитесь экрана для продолжения" FontSize="12" Foreground="#80CBC4"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
