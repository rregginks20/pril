<Page x:Class="YanaulKioskPerfect.MedicalCardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Медицинская карта пациента" Background="#F5F9FC">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- === ЗАГОЛОВОК === -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <Button x:Name="BtnBack" Style="{StaticResource ModernButton}" Background="#81C784"
                        Content="⇦ Назад" Width="160" Height="50" Click="BtnBack_Click" HorizontalAlignment="Left"/>
                <TextBlock Text="🏥 МЕДИЦИНСКАЯ КАРТА ПАЦИЕНТА" FontSize="32" FontWeight="Bold" 
                           Foreground="#00695C" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                <TextBlock Text="Янаульская центральная районная больница" FontSize="18" 
                           Foreground="Gray" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- === ПРОФИЛЬ ПАЦИЕНТА === -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Background="White" Margin="0,0,0,20">
                <Grid Margin="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Фото/Аватар -->
                    <Border Grid.Column="0" Width="100" Height="100" CornerRadius="50" 
                            Background="#E0F2F1" BorderBrush="#009688" BorderThickness="3" ClipToBounds="True">
                        <TextBlock Text="👤" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Информация -->
                    <StackPanel Grid.Column="1" Margin="25,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PatientNameText" Text="Иванов Иван Иванович" 
                                   FontSize="24" FontWeight="Bold" Foreground="#00695C"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="📄 Полис: " FontSize="14" Foreground="Gray"/>
                            <TextBlock x:Name="PolicyNumberText" Text="1234567890123456" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="📅 Дата рождения: " FontSize="14" Foreground="Gray"/>
                            <TextBlock x:Name="BirthDateText" Text="15.03.1985 (41 год)" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="📱 Телефон: " FontSize="14" Foreground="Gray"/>
                            <TextBlock x:Name="PhoneText" Text="+7 (917) 123-45-67" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="📧 Email: " FontSize="14" Foreground="Gray"/>
                            <TextBlock x:Name="EmailText" Text="patient@email.ru" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Кнопки действий -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <!-- 🔹 НОВАЯ КНОПКА: Я ПРИШЕЛ -->
                        <Button x:Name="BtnCheckIn" Content="📱 Я пришел! (В очередь)" 
                                Background="#FF9800" Foreground="White" Height="50" Width="240"
                                FontSize="16" FontWeight="Bold" Click="BtnCheckIn_Click" Cursor="Hand" Margin="0,0,0,10"/>

                        <Button x:Name="BtnSendAll" Content="📧 Отправить всё на почту" 
                                Background="#2196F3" Foreground="White" Height="45" Width="240"
                                FontSize="14" FontWeight="Bold" Click="BtnSendAll_Click" Cursor="Hand" Margin="0,0,0,10"/>

                        <Button x:Name="BtnPrintAll" Content="🖨️ Распечатать всё" 
                                Background="#9C27B0" Foreground="White" Height="45" Width="240"
                                FontSize="14" FontWeight="Bold" Click="BtnPrintAll_Click" Cursor="Hand" Margin="0,0,0,10"/>

                        <Button x:Name="BtnTestEmail" Content="🔧 Тест почты" 
                                Background="#607D8B" Foreground="White" Height="40" Width="240"
                                FontSize="13" FontWeight="Bold" Click="BtnTestEmail_Click" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- === РАЗДЕЛЫ МЕДКАРТЫ === -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Background="White" Margin="0,0,0,20">
                <StackPanel Margin="30">
                    <TextBlock Text="📊 РАЗДЕЛЫ МЕДКАРТЫ" FontSize="22" FontWeight="Bold" 
                               Foreground="#00695C" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Анализы -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#E8F5E9" CornerRadius="15" 
                                Padding="25" Margin="0,0,10,10" Cursor="Hand" MouseLeftButtonDown="Analyses_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center"/>
                                <TextBlock Text="АНАЛИЗЫ" FontSize="16" FontWeight="Bold" 
                                           Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                <TextBlock x:Name="AnalysesCountText" Text="12 результатов" FontSize="13" 
                                           Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Рецепты -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#FFF3E0" CornerRadius="15" 
                                Padding="25" Margin="0,0,10,10" Cursor="Hand" MouseLeftButtonDown="Prescriptions_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="💊" FontSize="40" HorizontalAlignment="Center"/>
                                <TextBlock Text="РЕЦЕПТЫ" FontSize="16" FontWeight="Bold" 
                                           Foreground="#E65100" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                <TextBlock x:Name="PrescriptionsCountText" Text="5 рецептов" FontSize="13" 
                                           Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Справки -->
                        <Border Grid.Row="0" Grid.Column="2" Background="#E3F2FD" CornerRadius="15" 
                                Padding="25" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonDown="Certificates_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📄" FontSize="40" HorizontalAlignment="Center"/>
                                <TextBlock Text="СПРАВКИ" FontSize="16" FontWeight="Bold" 
                                           Foreground="#1565C0" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                <TextBlock x:Name="CertificatesCountText" Text="8 документов" FontSize="13" 
                                           Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Прививки -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#FCE4EC" CornerRadius="15" 
                                Padding="25" Margin="0,10,10,0" Cursor="Hand" MouseLeftButtonDown="Vaccinations_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="💉" FontSize="40" HorizontalAlignment="Center"/>
                                <TextBlock Text="ПРИВИВКИ" FontSize="16" FontWeight="Bold" 
                                           Foreground="#C2185B" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                <TextBlock x:Name="VaccinationsCountText" Text="7 прививок" FontSize="13" 
                                           Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Оплата -->
                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="#F3E5F5" CornerRadius="15" 
                                Padding="25" Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonDown="Payments_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="💳" FontSize="40" HorizontalAlignment="Center"/>
                                <TextBlock Text="ОПЛАТА" FontSize="16" FontWeight="Bold" 
                                           Foreground="#6A1B9A" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                <TextBlock Text="История платежей" FontSize="13" 
                                           Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- === УВЕДОМЛЕНИЯ === -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Background="White" Margin="0,0,0,20">
                <StackPanel Margin="30">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="🔔 ПОСЛЕДНИЕ УВЕДОМЛЕНИЯ" FontSize="20" FontWeight="Bold" 
                                   Foreground="#00695C"/>
                        <TextBlock x:Name="NotificationsCountText" Text=" (3)" FontSize="18" 
                                   Foreground="Gray" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="NotificationsPanel">
                        <!-- Уведомления загружаются из БД -->
                    </StackPanel>

                    <Button x:Name="BtnViewAllNotifications" Content="📋 Показать все уведомления" 
                            Background="#E0E0E0" Foreground="#424242" Height="45" Width="250"
                            FontSize="14" Click="BtnViewAllNotifications_Click" Cursor="Hand" 
                            HorizontalAlignment="Left" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>