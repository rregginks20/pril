<Page x:Class="YanaulKioskPerfect.AdminDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель регистратуры" Background="#F5F9FC">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" CornerRadius="20" Margin="0,0,0,16" Padding="24,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00695C" Offset="0"/>
                    <GradientStop Color="#00897B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="👨‍⚕️ ПАНЕЛЬ РЕГИСТРАТУРЫ" FontSize="32" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="LblDbStatus" Text="Загрузка..." FontSize="14" Foreground="#B2DFDB" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnOpenChat" Style="{StaticResource ModernButton}" Height="52" MinWidth="200"
                        Background="#7B1FA2" Foreground="White" FontSize="15" Margin="0,0,10,0"
                        Click="BtnOpenChat_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💬 Чат пациентов" VerticalAlignment="Center"/>
                        <Border x:Name="AdminChatBadge" Background="#F44336" CornerRadius="10" Padding="6,2" Margin="8,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="AdminChatBadgeText" Text="0" FontSize="11" Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Button>
                <Button Content="👨‍⚕️ Рабочее место" Style="{StaticResource ModernButton}" Height="52"
                        Background="#4CAF50" Foreground="White" FontSize="15" Margin="0,0,10,0"
                        Click="BtnDoctorWorkplace_Click"/>
                <Button Content="📊 Статистика" Style="{StaticResource ModernButton}" Height="52"
                        Background="#0288D1" Foreground="White" FontSize="15" Margin="0,0,10,0"
                        Click="BtnStatistics_Click"/>
                <Button Content="🔄 Обновить" Style="{StaticResource ModernButton}" Height="52"
                        Background="#455A64" Foreground="White" FontSize="15" Margin="0,0,10,0"
                        Click="BtnRefreshAll_Click"/>
                <Button Content="🚪 Выход" Style="{StaticResource ModernButton}" Height="52"
                        Background="#D32F2F" Foreground="White" FontSize="15"
                        Click="BtnExit_Click"/>
            </StackPanel>
            </Grid>
        </Border>

        <!-- KPI -->
        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,16">
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="👥 Пациенты" FontSize="13" Foreground="#666"/>
                    <TextBlock x:Name="KpiPatients" Text="0" FontSize="28" FontWeight="Bold" Foreground="#00695C"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="📅 Записи сегодня" FontSize="13" Foreground="#666"/>
                    <TextBlock x:Name="KpiAppointments" Text="0" FontSize="28" FontWeight="Bold" Foreground="#1565C0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="🏠 Вызовы на дом" FontSize="13" Foreground="#666"/>
                    <TextBlock x:Name="KpiHomeVisits" Text="0" FontSize="28" FontWeight="Bold" Foreground="#E65100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="💳 Платежи (всего)" FontSize="13" Foreground="#666"/>
                    <TextBlock x:Name="KpiPayments" Text="0 ₽" FontSize="22" FontWeight="Bold" Foreground="#6A1B9A"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="⭐ Отзывы" FontSize="13" Foreground="#666"/>
                    <TextBlock x:Name="KpiFeedbacks" Text="0" FontSize="28" FontWeight="Bold" Foreground="#F57F17"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="🔔 Уведомления" FontSize="13" Foreground="#666"/>
                    <TextBlock x:Name="KpiNotifications" Text="0" FontSize="28" FontWeight="Bold" Foreground="#C62828"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TabControl Grid.Row="2" FontSize="16" Background="Transparent">
            <TabItem Header="📋 Очередь на сегодня">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Background="White" Grid.Column="0" Margin="0,0,12,0">
                        <DockPanel Margin="12">
                            <TextBlock Text="Активные записи" FontSize="22" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                            <ListBox x:Name="QueueList" BorderThickness="0" SelectionChanged="QueueList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F5F5F5" Padding="14" Margin="0,0,0,8" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TicketNumber}" FontWeight="Bold" FontSize="16" Foreground="#0288D1"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding PatientName}" FontSize="16"/>
                                                    <TextBlock Text="{Binding AppointmentTime, StringFormat='{}{0:dd.MM HH:mm}'}" FontSize="13" Foreground="#777"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" HorizontalAlignment="Right" FontStyle="Italic"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Background="#E3F2FD" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Управление очередью" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                            <TextBlock x:Name="SelectedPatient" Text="Выберите пациента" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,20"/>
                            <Button Content="✅ ВЫЗВАТЬ ПАЦИЕНТА" Height="56" FontSize="17" FontWeight="Bold"
                                    Background="#4CAF50" Foreground="White" Margin="0,0,0,12" Click="BtnCallNext_Click"/>
                            <Button Content="❌ Отменить запись" Height="48" FontSize="15"
                                    Background="#F44336" Foreground="White" Click="BtnCancelAppointment_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="📅 Все записи">
                <Border Style="{StaticResource CardStyle}" Background="White" Margin="8" Padding="12">
                    <DataGrid x:Name="GridAllAppointments" AutoGenerateColumns="False" IsReadOnly="True"
                              RowHeight="42" FontSize="14" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Талон" Binding="{Binding TicketNumber}" Width="120"/>
                            <DataGridTextColumn Header="Пациент" Binding="{Binding PatientName}" Width="180"/>
                            <DataGridTextColumn Header="Полис" Binding="{Binding PolicyNumber}" Width="140"/>
                            <DataGridTextColumn Header="Время" Binding="{Binding AppointmentTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="👥 Пациенты">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox x:Name="PatientSearchBox" Width="320" Height="40" FontSize="16" VerticalContentAlignment="Center"
                                 Tag="Поиск по ФИО или полису..."/>
                        <Button Content="🔍 Найти" Height="40" Width="100" Margin="12,0,0,0"
                                Background="#009688" Foreground="White" BorderThickness="0" Click="BtnSearchPatients_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="GridPatients" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              RowHeight="40" FontSize="14" SelectionChanged="GridPatients_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding PatientName}" Width="220"/>
                            <DataGridTextColumn Header="Полис" Binding="{Binding PolicyNumber}" Width="150"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="130"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="💳 Платежи">
                <Border Style="{StaticResource CardStyle}" Background="White" Margin="8" Padding="12">
                    <DockPanel>
                        <TextBlock x:Name="LblPaymentsSummary" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <DataGrid x:Name="GridPayments" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="40" FontSize="14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding PaymentDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                                <DataGridTextColumn Header="Полис" Binding="{Binding PolicyNumber}" Width="140"/>
                                <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceRU}" Width="*"/>
                                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N0} ₽}" Width="100"/>
                                <DataGridTextColumn Header="Способ" Binding="{Binding PaymentMethod}" Width="120"/>
                                <DataGridTextColumn Header="Чек" Binding="{Binding ReceiptNumber}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="👨‍⚕️ Врачи">
                <DataGrid x:Name="GridDoctors" Margin="8" AutoGenerateColumns="False" IsReadOnly="True"
                          RowHeight="44" FontSize="14" Style="{StaticResource CardStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullNameRU}" Width="200"/>
                        <DataGridTextColumn Header="Специальность" Binding="{Binding SpecialtyRU}" Width="180"/>
                        <DataGridTextColumn Header="Кабинет" Binding="{Binding Room}" Width="80"/>
                        <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating}" Width="80"/>
                        <DataGridTextColumn Header="Цена приёма" Binding="{Binding Price, StringFormat={}{0:N0} ₽}" Width="110"/>
                        <DataGridTextColumn Header="График" Binding="{Binding Schedule}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="🚑 Диспетчерская">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Background="#FFEBEE" Margin="0,0,0,8" Padding="12">
                        <DockPanel>
                            <TextBlock Text="🏠 Вызовы на дом" FontSize="22" FontWeight="Bold" Foreground="#C62828" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                            <DataGrid x:Name="GridHomeVisits" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="44" FontSize="13"
                                      SelectionChanged="GridHomeVisits_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Время" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM HH:mm}}" Width="100"/>
                                    <DataGridTextColumn Header="Пациент" Binding="{Binding PatientName}" Width="160"/>
                                    <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*"/>
                                    <DataGridTextColumn Header="Симптомы" Binding="{Binding Symptoms}" Width="200"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button Content="✅ Подтвердить" Height="40" Padding="14,0" Background="#4CAF50" Foreground="White" Margin="0,0,8,0" Click="BtnConfirmHomeVisit_Click"/>
                                <Button Content="🏁 Завершить" Height="40" Padding="14,0" Background="#2196F3" Foreground="White" Margin="0,0,8,0" Click="BtnCompleteHomeVisit_Click"/>
                                <Button Content="❌ Отменить" Height="40" Padding="14,0" Background="#757575" Foreground="White" Click="BtnCancelHomeVisit_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Background="#F3E5F5" Margin="0,8,0,0" Padding="12">
                        <DockPanel>
                            <TextBlock Text="🤖 История триажа" FontSize="22" FontWeight="Bold" Foreground="#6A1B9A" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                            <DataGrid x:Name="GridTriage" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="44" FontSize="13">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Время" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM HH:mm}}" Width="100"/>
                                    <DataGridTextColumn Header="Жалоба" Binding="{Binding UserInput}" Width="280"/>
                                    <DataGridTextColumn Header="Симптомы" Binding="{Binding DetectedSymptoms}" Width="150"/>
                                    <DataGridTextColumn Header="Рекомендация" Binding="{Binding RecommendedDoctorSpecialty}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="⭐ Отзывы">
                <DataGrid x:Name="GridFeedbacks" Margin="8" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="48" FontSize="14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130"/>
                        <DataGridTextColumn Header="Врач" Binding="{Binding DoctorName}" Width="180"/>
                        <DataGridTextColumn Header="Пациент" Binding="{Binding PatientName}" Width="160"/>
                        <DataGridTextColumn Header="Оценка" Binding="{Binding Rating}" Width="70"/>
                        <DataGridTextColumn Header="Текст" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="🔔 Уведомления">
                <DataGrid x:Name="GridNotifications" Margin="8" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="44" FontSize="14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                        <DataGridTextColumn Header="Полис" Binding="{Binding PatientPolicy}" Width="140"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100"/>
                        <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Прочитано" Binding="{Binding IsRead}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
