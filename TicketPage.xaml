<Page x:Class="YanaulKioskPerfect.TicketPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Электронный талон" Background="#F5F9FC">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- === ЗАГОЛОВОК === -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
                <TextBlock Text="✅ ЗАПИСЬ ПОДТВЕРЖДЕНА!" FontSize="36" FontWeight="Bold" 
Foreground="#4CAF50" HorizontalAlignment="Center"/>
                <TextBlock Text="Сохраните этот талон" FontSize="18" Foreground="Gray" 
HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- === ТАЛОН === -->
            <Border Grid.Row="1" Background="White" CornerRadius="20" Padding="40" 
MaxWidth="700" HorizontalAlignment="Center">
                <StackPanel>

                    <!-- Номер талона -->
                    <Border Background="#E8F5E9" CornerRadius="15" Padding="20" Margin="0,0,0,30">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="НОМЕР ТАЛОНА" FontSize="14" Foreground="#666" 
HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TicketNumberText" Text="YNA-240615123456" FontSize="42" 
FontWeight="Bold" Foreground="#E91E63" HorizontalAlignment="Center"
FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                    <!-- Информация о приеме -->
                    <StackPanel Margin="0,0,0,30">
                        <TextBlock Text="📅 ДАТА И ВРЕМЯ ПРИЕМА" FontSize="18" FontWeight="Bold" 
Foreground="#00695C" Margin="0,0,0,15"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📅" FontSize="28" Grid.Column="0"/>
                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                <TextBlock Text="Дата приема:" FontSize="14" Foreground="Gray"/>
                                <TextBlock x:Name="AppointmentDateText" Text="15.06.2026 14:00" 
FontSize="22" FontWeight="Bold" Foreground="#333"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="👨‍⚕️" FontSize="28" Grid.Column="0"/>
                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                <TextBlock Text="Врач:" FontSize="14" Foreground="Gray"/>
                                <TextBlock x:Name="AppointmentDoctorText" Text="Иванова Анна Петровна" 
FontSize="22" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock x:Name="AppointmentSpecialtyText" Text="Терапевт • Кабинет 205" 
FontSize="16" Foreground="#666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="👤" FontSize="28" Grid.Column="0"/>
                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                <TextBlock Text="Пациент:" FontSize="14" Foreground="Gray"/>
                                <TextBlock x:Name="AppointmentPatientText" Text="Иванов Иван Иванович" 
FontSize="22" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock x:Name="AppointmentPolicyText" Text="Полис: 1234567890123456" 
FontSize="16" Foreground="#666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💰" FontSize="28" Grid.Column="0"/>
                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                <TextBlock Text="Стоимость:" FontSize="14" Foreground="Gray"/>
                                <TextBlock x:Name="AppointmentPriceText" Text="Бесплатно (по ОМС)" 
FontSize="22" FontWeight="Bold" Foreground="#4CAF50"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- QR-код -->
                    <Border Background="#F5F5F5" CornerRadius="15" Padding="30" Margin="0,0,0,30">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📱 Отсканируйте для перехода на сайт поликлиники" 
FontSize="14" Foreground="#666" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                            <Border Background="White" CornerRadius="10" Padding="20">
                                <Image x:Name="QRCodeImage" Width="200" Height="200"/>
                            </Border>
                            <TextBlock x:Name="QRCodeUrlText" Text="health.bashkortostan.ru" 
FontSize="14" Foreground="#999" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Важная информация -->
                    <Border Background="#FFEBEE" CornerRadius="15" Padding="20" Margin="0,0,0,30">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="32" Margin="0,0,15,0"/>
                            <StackPanel>
                                <TextBlock Text="ВАЖНО!" FontSize="18" FontWeight="Bold" Foreground="#D32F2F"/>
                                <TextBlock x:Name="ImportantInfoText" Text="Подойдите к кабинету за 15 минут до начала приема. 
При себе иметь паспорт и полис ОМС." 
FontSize="15" Foreground="#333" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- === КНОПКИ ДЕЙСТВИЙ (ОТДЕЛЬНО ОТ ТАЛОНА!) === -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" 
Margin="0,30,0,20">
                <Button x:Name="BtnPrint" Content="🖨️ Распечатать талон" Width="280" Height="65" 
FontSize="18" FontWeight="Bold" Background="#2196F3" Foreground="White"
BorderThickness="0" Click="BtnPrint_Click" Cursor="Hand" Margin="0,0,15,0"/>
                <Button x:Name="BtnSave" Content="💾 Сохранить в PDF" Width="280" Height="65" 
FontSize="18" FontWeight="Bold" Background="#9C27B0" Foreground="White"
BorderThickness="0" Click="BtnSave_Click" Cursor="Hand" Margin="0,0,15,0"/>
                <Button x:Name="BtnHome" Content="🏠 В главное меню" Width="280" Height="65" 
FontSize="18" FontWeight="Bold" Background="#4CAF50" Foreground="White"
BorderThickness="0" Click="BtnHome_Click" Cursor="Hand"/>
            </StackPanel>

            <!-- === ДОПОЛНИТЕЛЬНАЯ ИНФОРМАЦИЯ === -->
            <Border Grid.Row="3" Background="White" CornerRadius="15" Padding="25" 
MaxWidth="700" HorizontalAlignment="Center" Margin="0,0,0,40">
                <StackPanel>
                    <TextBlock Text="📋 Как подготовиться к приему" FontSize="20" FontWeight="Bold" 
Foreground="#00695C" Margin="0,0,0,15"/>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="1. Придите за 15 минут до начала приема" FontSize="15" 
Foreground="#333" Margin="0,5,0,0"/>
                        <TextBlock Text="2. Возьмите с собой паспорт и полис ОМС" FontSize="15" 
Foreground="#333" Margin="0,5,0,0"/>
                        <TextBlock Text="3. При наличии — предыдущие медицинские документы" FontSize="15" 
Foreground="#333" Margin="0,5,0,0"/>
                        <TextBlock Text="4. Запишите все вопросы врачу заранее" FontSize="15" 
Foreground="#333" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Border Background="#E3F2FD" CornerRadius="10" Padding="15" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="📞 Контакты регистратуры:" FontSize="15" FontWeight="SemiBold" 
Foreground="#1976D2"/>
                            <TextBlock Text="+7 (34783) 2-14-79" FontSize="18" FontWeight="Bold" 
Foreground="#1976D2" Margin="0,5,0,0"/>
                            <TextBlock Text="ул. Худайбердина, 65А, г. Янаул" FontSize="14" Foreground="#666" 
Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>