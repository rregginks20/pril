<Page x:Class="YanaulKioskPerfect.HospitalMapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Карта больницы" 
      Background="#F5F7FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Style="{StaticResource ModernButton}" 
                    Content="⇦ Назад" Width="140" Height="50" FontSize="16"
                    Background="#81C784" Foreground="White"
                    Click="BtnBack_Click"/>

            <TextBlock x:Name="TitleText" Text="КАРТА БОЛЬНИЦЫ"
                       FontSize="32" FontWeight="Bold" Foreground="#004D40"
                       VerticalAlignment="Center" Margin="30,0,0,0"/>

            <ComboBox x:Name="FloorSelector" 
                      FontSize="18" Width="200" Height="50" 
                      Margin="40,0,0,0" VerticalContentAlignment="Center"
                      SelectionChanged="FloorSelector_SelectionChanged">
                <ComboBoxItem Content="1 Этаж" IsSelected="True"/>
                <ComboBoxItem Content="2 Этаж"/>
                <ComboBoxItem Content="3 Этаж"/>
            </ComboBox>
        </StackPanel>

        <!-- ОСНОВНАЯ ОБЛАСТЬ (2 колонки) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ЧАСТЬ: КАРТА (Текст) -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="30">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="MapTitle" Text="1 ЭТАЖ" 
                                   FontSize="28" FontWeight="Bold" Foreground="#00695C"
                                   Margin="0,0,0,20" TextAlignment="Center"/>

                        <!-- Блок с информацией -->
                        <Border x:Name="MapBorder" Background="#E8F5E9" 
                                BorderBrush="#C8E6C9" BorderThickness="2" 
                                CornerRadius="10" Padding="25">
                            <TextBlock x:Name="MapContent" 
                                       FontSize="18" LineHeight="32" TextWrapping="Wrap"
                                       Foreground="#333333">
                                <!-- Текст загружается из кода -->
                            </TextBlock>
                        </Border>

                        <TextBlock x:Name="SearchResultText" 
                                   FontSize="18" FontWeight="Bold" 
                                   Foreground="#D32F2F" Margin="0,15,0,0" 
                                   Visibility="Collapsed" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ПРАВАЯ ЧАСТЬ: ПОИСК И КАТЕГОРИИ -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" 
                    Background="#FFF8E1" Margin="20,0,0,0" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="🔍 Поиск кабинета" 
                                   FontSize="22" FontWeight="Bold" Foreground="#E65100" 
                                   Margin="0,0,0,15"/>

                        <TextBox x:Name="SearchBox" 
                                 FontSize="18" Height="50" Padding="15" 
                                 Margin="0,0,0,25" 
                                 TextChanged="SearchBox_TextChanged"
                                 BorderBrush="#FF9800" BorderThickness="2"/>

                        <TextBlock Text="Категории" 
                                   FontSize="22" FontWeight="Bold" Foreground="#E65100" 
                                   Margin="0,0,0,15"/>

                        <Button Style="{StaticResource ModernButton}" 
                                Content="💉 Лаборатория" Height="55" FontSize="18"
                                Background="#FF9800" Foreground="White"
                                Click="CategoryBtn_Click" Tag="lab"/>

                        <Button Style="{StaticResource ModernButton}" 
                                Content="💊 Аптека" Height="55" FontSize="18"
                                Background="#2196F3" Foreground="White"
                                Margin="0,10,0,0"
                                Click="CategoryBtn_Click" Tag="pharmacy"/>

                        <Button Style="{StaticResource ModernButton}" 
                                Content="📝 Регистратура" Height="55" FontSize="18"
                                Background="#4CAF50" Foreground="White"
                                Margin="0,10,0,0"
                                Click="CategoryBtn_Click" Tag="registry"/>

                        <Button Style="{StaticResource ModernButton}" 
                                Content="👨‍⚕️ Врачи" Height="55" FontSize="18"
                                Background="#9C27B0" Foreground="White"
                                Margin="0,10,0,0"
                                Click="CategoryBtn_Click" Tag="doctors"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>