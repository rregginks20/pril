<Page x:Class="YanaulKioskPerfect.VaccineCertificatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сертификат вакцинации" Background="#F5F9FC">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30">
        <StackPanel MaxWidth="800" HorizontalAlignment="Center">
            <TextBlock Text="💉 ЭЛЕКТРОННЫЙ СЕРТИФИКАТ" FontSize="32" FontWeight="Bold" Foreground="#009688" Margin="0,0,0,10" TextAlignment="Center"/>

            <Border Background="White" CornerRadius="15" Padding="30" BorderBrush="#80CBC4" BorderThickness="1" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Введите номер полиса:" FontSize="18" Margin="0,0,0,10"/>
                    <TextBox x:Name="PolicyInput" Height="45" FontSize="18" Margin="0,0,0,20" Padding="10" Text="1234567890123456"/>
                    <Button Content="🔍 Получить сертификат" Height="55" FontSize="18" Background="#009688" Foreground="White" BorderThickness="0" Click="BtnGetCert_Click" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border x:Name="CertResult" Visibility="Collapsed" Background="#E0F2F1" CornerRadius="15" Padding="30" BorderBrush="#009688" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="✅ СПРАВКА О ВАКЦИНАЦИИ" FontSize="24" FontWeight="Bold" Foreground="#00695C" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock x:Name="CertPatientName" FontSize="18" Margin="0,0,0,5"/>
                    <TextBlock x:Name="CertPolicy" FontSize="16" Foreground="#555" Margin="0,0,0,20"/>

                    <DataGrid x:Name="VaccinesGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="White" Margin="0,0,0,20">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="150"/>
                            <DataGridTextColumn Header="Вакцина" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Серия" Binding="{Binding Series}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Документ сформирован автоматически." FontSize="14" Foreground="#777" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <Button Content="← Назад" Height="50" Margin="0,20,0,0" Background="#95A5A6" Foreground="White" BorderThickness="0" Click="BtnBack_Click" Cursor="Hand" Padding="20,10"/>
        </StackPanel>
    </ScrollViewer>
</Page>