<Page x:Class="YanaulKioskPerfect.DispatcherPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель Диспетчера" Background="#F0F2F5">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с кнопками -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="⇦ Назад" Width="140" Height="50" FontSize="16" Background="#81C784" Foreground="White" BorderThickness="0" Click="BtnBack_Click" Cursor="Hand"/>
            <TextBlock Text="🚑 ПАНЕЛЬ ДИСПЕТЧЕРА" FontSize="32" FontWeight="Bold" Foreground="#C62828" VerticalAlignment="Center" Margin="30,0,0,0"/>
            <Button Content="🔄 Обновить" Margin="30,0,0,0" Padding="20,10" FontSize="16" Background="#0288D1" Foreground="White" BorderThickness="0" Click="BtnRefresh_Click" Cursor="Hand"/>
        </StackPanel>

        <!-- Табы (Вкладки) -->
        <TabControl Grid.Row="1" FontSize="18" Background="Transparent">

            <!-- Вкладка 1: Вызовы на дом -->
            <TabItem Header="🏠 Вызовы на дом">
                <Grid Margin="10">
                    <DataGrid x:Name="GridHomeVisits" AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="60" FontSize="16" BorderThickness="0" Background="White" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFCDD2"/>
                                <Setter Property="Foreground" Value="#B71C1C"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="15,10"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM HH:mm}}" Width="130"/>
                            <DataGridTextColumn Header="Пациент" Binding="{Binding PatientName}" Width="200"/>
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*"/>
                            <DataGridTextColumn Header="Симптомы" Binding="{Binding Symptoms}" Width="250"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: История Триаж (Умный подбор) -->
            <TabItem Header="🤖 История подбора врача">
                <Grid Margin="10">
                    <DataGrid x:Name="GridTriage" AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="60" FontSize="16" BorderThickness="0" Background="White" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F4ECF7"/>
                                <Setter Property="Foreground" Value="#8E44AD"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="15,10"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Время" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM HH:mm}}" Width="130"/>
                            <DataGridTextColumn Header="Жалоба" Binding="{Binding UserInput}" Width="300"/>
                            <DataGridTextColumn Header="Найдено" Binding="{Binding DetectedSymptoms}" Width="150"/>
                            <DataGridTextColumn Header="Рекомендация" Binding="{Binding RecommendedDoctorSpecialty}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <!-- ^^^ ВОТ ЭТОГО ТЕГА НЕ ХВАТАЛО РАНЬШЕ! -->

        </TabControl>
    </Grid>
</Page>