                                          Fill="#EF6C00" Width="50" Height="50" Margin="0,0,0,15">
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#EF6C00"/>
                                        </Path.Effect>
                                    </Path>
                                    <TextBlock x:Name="TitleTextBlock" Text="Виртуальная очередь" FontSize="26" FontWeight="ExtraBold" Foreground="#E65100" TextAlignment="Center"/>
