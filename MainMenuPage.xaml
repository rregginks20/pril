                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 6. Информация -->
                <Button Margin="12" Height="180" Cursor="Hand" Click="BtnInfo_Click" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="MainBorder" CornerRadius="20" BorderThickness="0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#EFEBE9" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="ShadowEffect" BlurRadius="15" ShadowDepth="5" Opacity="0.15" Color="#5D4037"/>
                                </Border.Effect>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" 
                                          Fill="#5D4037" Width="50" Height="50" Margin="0,0,0,15">
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#5D4037"/>
                                        </Path.Effect>
                                    </Path>
                                    <TextBlock x:Name="TitleTextBlock" Text="Информация" FontSize="26" FontWeight="ExtraBold" Foreground="#3E2723" TextAlignment="Center"/>
