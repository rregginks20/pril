<Page x:Class="YanaulKioskPerfect.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главное меню">

    <!-- ГЛУБОКИЙ ГРАДИЕНТНЫЙ ФОН -->
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E0F7FA" Offset="0"/>
            <GradientStop Color="#C8E6C9" Offset="0.5"/>
            <GradientStop Color="#A5D6A7" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <Grid Margin="30,20,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ЗАГОЛОВОК С ГРАДИЕНТОМ И ТЕНЬЮ -->
            <TextBlock Grid.Row="0" x:Name="TitleText"
                       Text="ВЫБЕРИТЕ УСЛУГУ"
                       FontSize="52" FontWeight="ExtraBold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,50"
                       TextWrapping="Wrap">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#004D40" Offset="0"/>
                        <GradientStop Color="#2E7D32" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- СЕТКА КНОПОК -->
            <UniformGrid Grid.Row="1" Columns="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                <!-- 1. Запись к врачу -->
                <Button Margin="12" Height="180" Cursor="Hand" Click="BtnBookDoctor_Click" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="MainBorder" CornerRadius="20" BorderThickness="0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#F1F8E9" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="ShadowEffect" BlurRadius="15" ShadowDepth="5" Opacity="0.15" Color="#2E7D32"/>
                                </Border.Effect>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- Иконка -->
                                    <Path Data="M19,4H18V2H16V4H8V2H6V4H5A2,2 0 0,0 3,6V20A2,2 0 0,0 5,22H19A2,2 0 0,0 21,20V6A2,2 0 0,0 19,4M19,20H5V10H19V20M19,8H5V6H19V8Z" 
                                          Fill="#2E7D32" Width="50" Height="50" Margin="0,0,0,15">
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#2E7D32"/>
                                        </Path.Effect>
                                    </Path>
                                    <TextBlock x:Name="TitleTextBlock" Text="Запись к врачу" FontSize="26" FontWeight="ExtraBold" Foreground="#1B5E20" TextAlignment="Center"/>
                                    <TextBlock x:Name="SubTextBlock" Text="Выбор специалиста" FontSize="16" Foreground="#558B2F" TextAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Анимация фона -->
                                                <ColorAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)" To="#C8E6C9" Duration="0:0:0.3"/>
                                                <!-- Анимация тени (подъем) -->
                                                <DoubleAnimation Storyboard.TargetName="ShadowEffect" Storyboard.TargetProperty="BlurRadius" To="30" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="ShadowEffect" Storyboard.TargetProperty="ShadowDepth" To="10" Duration="0:0:0.3"/>
                                                <!-- Анимация увеличения всей кнопки -->
                                                <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)" To="#F1F8E9" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="ShadowEffect" Storyboard.TargetProperty="BlurRadius" To="15" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="ShadowEffect" Storyboard.TargetProperty="ShadowDepth" To="5" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 2. Моя медкарта -->
                <Button Margin="12" Height="180" Cursor="Hand" Click="BtnMedicalCard_Click" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="MainBorder" CornerRadius="20" BorderThickness="0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E3F2FD" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="ShadowEffect" BlurRadius="15" ShadowDepth="5" Opacity="0.15" Color="#1976D2"/>
                                </Border.Effect>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" 
                                          Fill="#1976D2" Width="50" Height="50" Margin="0,0,0,15">
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#1976D2"/>
                                        </Path.Effect>
                                    </Path>
                                    <TextBlock x:Name="TitleTextBlock" Text="Моя медкарта" FontSize="26" FontWeight="ExtraBold" Foreground="#0D47A1" TextAlignment="Center"/>
                                    <TextBlock x:Name="SubTextBlock" Text="Анализы, рецепты" FontSize="16" Foreground="#1565C0" TextAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)" To="#90CAF9" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="ShadowEffect" Storyboard.TargetProperty="BlurRadius" To="30" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="ShadowEffect" Storyboard.TargetProperty="ShadowDepth" To="10" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)" To="#E3F2FD" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="ShadowEffect" Storyboard.TargetProperty="BlurRadius" To="15" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="ShadowEffect" Storyboard.TargetProperty="ShadowDepth" To="5" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 3. Вызов врача -->
